# Copy to .env and fill in your key:
# cp backend/.env.example .env

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=postgresql://cricchat:cricchat@localhost:5432/cricchat

# Comma-separated browser origins (local + production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cricchat.vercel.app
